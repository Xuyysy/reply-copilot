import Base from "../layouts/Base.astro";
---
<Base title="Privacy">
  <div class="container page-hero"><div class="eyebrow" data-zh="隐私">Privacy</div><h1 data-zh="尽可能少地收集。">Data, with restraint.</h1><p class="lead" data-zh="以下为产品隐私政策草案，正式上线前需经营者审核确认。">Draft privacy policy. The operator must review and approve it before public launch.</p></div>
  <article class="container legal"><h2 data-zh="我们处理什么">What we process</h2><p data-zh="邮箱用于账户登录；试用和每日用量由服务端记录。生成回复时，当前 X 帖子内容、你提供的风格与写作样本会送往 AI 服务处理。">Your email supports account login. Trial dates and daily usage are stored server-side. To generate a draft, the current X post and the style information you provide are sent to the AI service.</p><h2 data-zh="我们不收集什么">What we avoid</h2><p data-zh="不收集完整 X Cookie，不自动发布评论，不长期存储完整原帖或回复正文。个人 BYOK Key 保存在本地扩展存储，不发送到 Reply Copilot 后端。">We do not collect your X cookies or post replies for you. Full post and reply text is not retained long-term. Your BYOK key stays in the extension's local storage and is not sent to the Reply Copilot backend.</p><h2 data-zh="保留与删除">Retention and deletion</h2><p data-zh="验证码短时有效；生成结果暂存 10 分钟用于安全重试，AI 请求元数据保留 30 天，每日用量保留 90 天。账户删除与数据请求渠道待正式上线前确认。">Codes expire quickly. Generated output is kept for 10 minutes for safe retries, AI request metadata for 30 days, and daily usage records for 90 days. Account deletion and data request channels require review before launch.</p><p class="notice" data-zh="草案：本页尚未经过经营者或法律专业人士最终审核。">Draft: this page has not received final operator or legal review.</p></article>
</Base>
