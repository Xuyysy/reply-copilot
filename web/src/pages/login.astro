---
import Base from "../layouts/Base.astro";
import AuthPanel from "../components/auth/AuthPanel";
const localVerification = import.meta.env.DEV;
const sitekey = localVerification ? "" : (import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "");
---
<Base title="注册与登录" titleEn="Sign in or register">
  <div class="container page-hero" style="text-align:center;margin:auto;padding-bottom:0"><div class="eyebrow" data-zh="账户">Account</div><h1 data-zh="欢迎使用 Reply Copilot">Welcome to Reply Copilot</h1><p class="lead" style="margin:auto" data-zh="验证邮箱后赠送 200 次永久有效的 AI 生成额度。">Verify your email for 200 AI generations that do not expire.</p></div>
  <section class="container app-shell"><AuthPanel client:load localVerification={localVerification} sitekey={sitekey} /></section>
  {sitekey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>}
</Base>
