---
import Base from "../layouts/Base.astro";
---
<Base title="价格与充值" titleEn="Pricing and credits">
  <div class="container page-hero"><div class="eyebrow" data-zh="按量使用">Pay as you go</div><h1 data-site-text="packageTitle" data-zh="新人绑定后领 200 次，之后按需充值。">Claim 200 free generations after linking, then top up.</h1><p class="lead" data-site-text="packageBody" data-zh="无需订阅、买断或自备 API Key。每次生成三种候选，只消耗一次。额度不主动过期。">No subscription, license purchase, or personal API key. Three styles count as one generation. Credits do not expire.</p></div>
  <section class="container section" style="padding-top:20px"><div class="grid-3"><div class="pricing-card featured"><h3 id="free-title" data-zh="免费赠送">Free grant</h3><div class="price">$0</div><p id="free-detail" data-zh="正在确认账户状态…">Checking account status…</p><a id="free-action" class="button" href="/login?mode=register" hidden data-zh="免费注册领取">Register for free</a><button id="free-retry" class="button secondary" type="button" hidden data-zh="重试">Retry</button></div><div class="pricing-card grid-span-2"><div class="eyebrow" data-zh="充值套餐">Top-up packages</div><div id="packages" class="grid-3" style="margin-top:20px"><p data-zh="正在读取套餐…">Loading packages…</p></div><p id="payment-status" class="notice" style="margin-top:20px" data-zh="付款尚未开放。当前可查看套餐，不能完成真实购买。">Checkout is not open. You can view packages, but cannot pay yet.</p></div></div></section>
  <script>
    import {api, ApiError} from "../lib/api";
    import {packageSummary} from "../lib/package-summary.mjs";
    type Package={id:string;name_zh:string;name_en:string;credits:number;price_cents:number;promo_price_cents:number|null;currency:string;fee_rate_bps:number;total_payment_fen?:number|null;merchant_pricing?:{feeBearer:string;rateBps:number;status:string};description_zh?:string;description_en?:string;featured?:boolean;recommended_label_zh?:string;recommended_label_en?:string};
    let packages:Package[]|null=null;
    const label=(zh:string,en:string)=>document.documentElement.lang==="en"?en:zh;
    function render(){const box=document.getElementById("packages")!;box.replaceChildren();if(!packages){box.textContent=label("套餐暂时无法加载，请稍后重试。","Packages are temporarily unavailable. Please retry.");return;}if(!packages.length){box.textContent=label("暂无可购买套餐。","No packages are available.");return;}for(const pkg of packages){const summary=packageSummary(pkg,document.documentElement.lang);const card=document.createElement("div");card.className=pkg.featured?"content-card package-highlight":"content-card";if(summary.badge){const badge=document.createElement("p");badge.className="package-badge";badge.textContent=summary.badge;card.append(badge);}const heading=document.createElement("h3");heading.textContent=summary.name;const price=document.createElement("strong");price.textContent=summary.price;const detail=document.createElement("p");detail.textContent=summary.credits;const description=document.createElement("p");description.textContent=(document.documentElement.lang==="en"?pkg.description_en:pkg.description_zh)||"";const cny=document.createElement("p");cny.textContent=summary.cny;const fee=document.createElement("p");fee.textContent=summary.fee;const link=document.createElement("a");link.className="button secondary";link.href=`/checkout?package=${encodeURIComponent(pkg.id)}`;link.textContent=label("查看套餐","View package");card.append(heading,price,detail,description,cny,fee,link);box.append(card);}}
    async function load(){try{const data=await api<{packages:Package[];paymentAvailable:boolean}>("/v1/packages");packages=data.packages;document.getElementById("payment-status")!.hidden=data.paymentAvailable;render();}catch{packages=null;render();}}void load();window.addEventListener("reply-copilot-language",render);
    let refreshTimer:ReturnType<typeof setTimeout>|undefined;
    window.addEventListener("focus",()=>{if(refreshTimer)clearTimeout(refreshTimer);refreshTimer=setTimeout(()=>void load(),250);});
    type Quota={quota:{freeRemaining:number;paidRemaining:number;totalRemaining:number};signupBenefit?:{status:"pending"|"granted";amount:number}|null};
    let freeState: "loading"|"guest"|"pending"|"ready"|"empty"|"error"="loading";
    let freeQuota:Quota["quota"]|null=null;
    function renderFree(){
      const title=document.getElementById("free-title")!,detail=document.getElementById("free-detail")!,action=document.getElementById("free-action") as HTMLAnchorElement,retry=document.getElementById("free-retry")!;
      const values={loading:["免费赠送","正在确认账户状态…","", ""],guest:["免费体验","验证邮箱并首次绑定符合资格的插件，可领取 200 次 AI 生成。","免费注册领取","/login?mode=register"],pending:["新人额度待领取",`首次绑定符合资格的 Chrome 插件后可领取 200 次 · 当前余额 ${freeQuota?.totalRemaining ?? 0} 次`,"查看账户绑定","/account"],ready:["免费额度已领取",`免费剩余 ${freeQuota?.freeRemaining ?? 0} 次 · 当前总余额 ${freeQuota?.totalRemaining ?? 0} 次`,"查看我的账户","/account"],empty:["生成次数已用完","免费额度已领取，当前余额为 0 次。支付暂未开放。","查看充值套餐","/pricing#packages"],error:["暂时无法确认账户状态","请检查网络后重试。","", ""]} as const;
      const english={loading:["Free grant","Checking account status…","",""],guest:["Free trial","Verify email and link an eligible extension to claim 200 generations.","Register for free","/login?mode=register"],pending:["Welcome credits pending",`Connect an eligible Chrome extension to claim 200 credits · Current balance ${freeQuota?.totalRemaining ?? 0}`,"Connect your account","/account"],ready:["Free credits claimed",`${freeQuota?.freeRemaining ?? 0} free · ${freeQuota?.totalRemaining ?? 0} total remaining`,"View my account","/account"],empty:["Generations used up","Your free credits were claimed. Checkout is not open yet.","View plans","/pricing#packages"],error:["Account status unavailable","Check your connection and retry.","",""]} as const;
      const [heading,description,button,url]=(document.documentElement.lang==="en"?english:values)[freeState];title.textContent=heading;detail.textContent=description;action.textContent=button;action.href=url||"/pricing";action.hidden=!button;retry.hidden=freeState!=="error";retry.textContent=label("重试","Retry");
    }
    async function loadFree(){freeState="loading";renderFree();try{await api("/v1/me");const data=await api<Quota>("/v1/usage");freeQuota=data.quota;freeState=data.signupBenefit?.status==="pending"?"pending":data.quota.totalRemaining<=0?"empty":"ready";}catch(error){freeQuota=null;freeState=error instanceof ApiError&&error.status===401?"guest":"error";}renderFree();}
    document.getElementById("free-retry")?.addEventListener("click",()=>void loadFree());void loadFree();window.addEventListener("reply-copilot-language",renderFree);
  </script>
  <style>:global(.package-highlight){border:1px solid #94b8e7;background:#f8fbff}:global(.package-badge){font-size:12px;font-weight:600;color:#2361a8}</style>
</Base>
