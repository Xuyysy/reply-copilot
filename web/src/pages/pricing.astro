---
import Base from "../layouts/Base.astro";
---
<Base title="价格与充值">
  <div class="container page-hero"><div class="eyebrow" data-zh="按量使用">Pay as you go</div><h1 data-zh="注册赠送 200 次，之后按需充值。">200 free generations, then top up as needed.</h1><p class="lead" data-zh="无需订阅、买断或自备 API Key。每次生成三种候选，只消耗一次。额度不主动过期。">No subscription, license purchase, or personal API key. Three styles count as one generation. Credits do not expire.</p></div>
  <section class="container section" style="padding-top:20px"><div class="grid-3"><div class="pricing-card featured"><h3 data-zh="免费赠送">Free grant</h3><div class="price">$0</div><p data-zh="邮箱验证成功后一次性赠送 200 次。">200 generations once your email is verified.</p><a class="button" href="/login" data-zh="注册领取">Register</a></div><div class="pricing-card grid-span-2"><div class="eyebrow" data-zh="充值套餐">Top-up packages</div><div id="packages" class="grid-3" style="margin-top:20px"><p data-zh="正在读取套餐…">Loading packages…</p></div><p id="payment-status" class="notice" style="margin-top:20px" data-zh="付款尚未开放。当前可查看套餐，不能完成真实购买。">Checkout is not open. You can view packages, but cannot pay yet.</p></div></div></section>
  <script>
    import {api} from "../lib/api";
    async function load(){const box=document.getElementById("packages")!;try{const data=await api<{packages:Array<{id:string;name_zh:string;name_en:string;credits:number;price_cents:number;promo_price_cents:number|null;currency:string}>;paymentAvailable:boolean}>("/v1/packages");box.replaceChildren();for(const pkg of data.packages){const card=document.createElement("div");card.className="content-card";const heading=document.createElement("h3");heading.textContent=document.documentElement.lang==="en"?pkg.name_en:pkg.name_zh;const price=document.createElement("strong");price.textContent=new Intl.NumberFormat("en-US",{style:"currency",currency:pkg.currency}).format((pkg.promo_price_cents??pkg.price_cents)/100);const detail=document.createElement("p");detail.textContent=`${pkg.credits.toLocaleString()} 次 AI 生成`;const link=document.createElement("a");link.className="button secondary";link.href=`/checkout?package=${encodeURIComponent(pkg.id)}`;link.textContent=document.documentElement.lang==="en"?"Preview order":"查看订单预览";card.append(heading,price,detail,link);box.append(card);}if(!data.packages.length)box.textContent="暂无可购买套餐。";document.getElementById("payment-status")!.hidden=data.paymentAvailable;}catch{box.textContent="套餐暂时无法加载，请稍后再试。";}}load();window.addEventListener("reply-copilot-language",()=>void load());
  </script>
</Base>
