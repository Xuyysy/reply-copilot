---
import Base from "../layouts/Base.astro";
---
<Base title="套餐预览" titleEn="Package preview">
  <div class="container page-hero">
    <div class="eyebrow" data-zh="套餐预览">Package preview</div>
    <h1 data-zh="了解充值套餐。">Review the credit package.</h1>
    <p class="lead" data-zh="支付尚未开放。本页只展示套餐信息，不创建订单、不扣款，也不发放额度。">Payment is not available. This page only previews a package; it does not create an order, charge you, or grant credits.</p>
  </div>
  <section class="container" style="padding-bottom:100px">
    <div class="content-card" style="max-width:680px">
      <h2 id="package-name">正在读取套餐…</h2>
      <p id="package-credits"></p>
      <p id="package-price"></p>
      <p id="package-status" class="notice" data-zh="支付暂未开放，请稍后再来。">Payment is not open yet. Please check back later.</p>
      <div class="button-row"><a class="button secondary" href="/pricing" data-zh="返回套餐">Back to plans</a></div>
    </div>
  </section>
  <script>
    import { api } from "../lib/api";
    type Package = { id: string; name_zh: string; name_en: string; credits: number; price_cents: number; promo_price_cents: number | null; currency: string };
    const pkgId = new URL(location.href).searchParams.get("package") || "";
    const label = (zh: string, en: string) => document.documentElement.lang === "en" ? en : zh;
    let selected: Package | null = null;
    function render() {
      if (!selected) return;
      document.getElementById("package-name")!.textContent = document.documentElement.lang === "en" ? selected.name_en : selected.name_zh;
      document.getElementById("package-credits")!.textContent = label(`AI 生成次数：${selected.credits.toLocaleString()} 次`, `AI generations: ${selected.credits.toLocaleString()}`);
      document.getElementById("package-price")!.textContent = label("套餐金额：", "Package price: ") + new Intl.NumberFormat("en-US", { style: "currency", currency: selected.currency }).format((selected.promo_price_cents ?? selected.price_cents) / 100);
    }
    async function load() {
      try {
        const data = await api<{ packages: Package[] }>("/v1/packages");
        selected = data.packages.find(item => item.id === pkgId) || null;
        if (!selected) document.getElementById("package-status")!.textContent = label("套餐不存在或已下架。", "Package not found or unavailable.");
        render();
      } catch { document.getElementById("package-status")!.textContent = label("暂时无法读取套餐，请稍后重试。", "Unable to load packages. Please retry later."); }
    }
    void load();
    window.addEventListener("reply-copilot-language", render);
  </script>
</Base>
