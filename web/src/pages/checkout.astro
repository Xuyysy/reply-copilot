---
import Base from "../layouts/Base.astro";
---
<Base title="永久额度包结账" titleEn="Permanent credit pack checkout">
  <div class="container page-hero">
    <div class="eyebrow" data-zh="安全结账">Secure checkout</div>
    <h1 data-zh="永久额度包结账">Permanent credit pack checkout</h1>
    <p class="lead" data-zh="这是一次性购买的永久额度包，不是 30 天订阅。额度包不按天清零、不主动过期；订阅日额度用完后先使用剩余免费额度，免费额度耗尽后才扣本额度包。美元标价与人民币实付金额将分别展示，付款前请核对。">This is a one-time permanent credit pack, not a 30-day subscription. Credits do not reset daily or expire automatically and are spent only after the subscription daily allowance and any remaining free credits. Prices are shown in USD, with the final CNY payment shown before checkout.</p>
  </div>
  <section class="container" style="padding-bottom:100px">
    <div class="content-card" style="max-width:680px">
      <h2 id="package-name">正在读取套餐…</h2>
      <p id="package-credits"></p>

      <p id="package-usd"></p>
      <p id="package-description"></p>
      <p id="package-fee"></p>
      <p id="package-cny" class="notice" aria-live="polite"></p>
      <section id="checkout-payment-method" class="checkout-payment-method" aria-labelledby="payment-method-title">
        <h3 id="payment-method-title" data-site-text="checkoutPaymentTitle" data-zh="支付方式">Payment method</h3>
        <div id="payment-method-options" role="radiogroup" aria-labelledby="payment-method-title"></div>
        <p id="payment-method-note" data-site-text="checkoutPaymentNote" data-zh="前往支付收银台完成付款。实际支付币种为人民币 CNY。">Continue to the payment cashier. The actual charge is in CNY.</p>
      </section>
      <p id="checkout-status" role="status" aria-live="polite"></p>
      <p id="quota-result" hidden></p>

      <p id="restart-notice" class="notice" hidden data-zh="重新发起会创建新的独立订单，旧订单不会取消。请勿同时支付多笔订单。">Restarting creates a separate order and does not cancel earlier orders. Do not pay multiple orders unintentionally.</p>
      <div class="button-row">
        <button id="create-order" class="button checkout-pay-button" type="button" disabled><span id="create-order-label" data-site-text="checkoutPayButton" data-site-dynamic-text="true" data-zh="使用支付宝付款">Pay with Alipay</span></button>
        <button id="restart-payment" class="button secondary" type="button" hidden data-zh="重新发起支付">Restart payment with a new order</button>
        <a id="cashier-link" class="button secondary" href="#" target="_blank" rel="noopener noreferrer" hidden data-zh="打开支付宝收银台">Open Alipay cashier</a>
        <section id="wechat-qr-panel" class="checkout-wechat-qr" hidden aria-labelledby="wechat-qr-title">
          <h3 id="wechat-qr-title" data-zh="用微信扫码完成支付">Scan with WeChat to continue</h3>
          <img id="wechat-qr-image" width="240" height="240" alt="微信支付收银台二维码" />
          <p data-zh="请使用手机微信扫描。扫码后将在手机微信中打开小豆收银台。">Scan with your phone. The Xiaodou cashier will open in WeChat.</p>
        </section>
        <p id="wechat-mobile-note" class="checkout-wechat-mobile-note" hidden data-zh="手机端请在微信内打开收银台；其他浏览器请复制支付链接并在微信中打开。">On mobile, open the cashier in WeChat. In other browsers, copy the payment link and open it in WeChat.</p>
        <button id="epay-submit" class="button checkout-pay-button" type="button" hidden><span id="epay-pay-label"><span id="epay-pay-text" data-site-text="checkoutPayButton" data-site-dynamic-text="true" data-zh="使用支付宝付款">Pay with Alipay</span></span><span id="epay-restore-label" hidden data-zh="恢复付款表单">Restore payment form</span></button>
        <button id="simulate-payment" class="button secondary" type="button" hidden data-zh="模拟支付完成">Simulate payment</button>
        <button id="refresh-order" class="button secondary" type="button" hidden data-zh="刷新支付状态">Refresh payment status</button>
        <button id="relaunch-rsa2" class="button secondary" type="button" hidden data-zh="重新生成原订单二维码">Generate a fresh QR code for this order</button>
        <a id="login-link" class="button secondary" href="/login?mode=login" hidden data-zh="登录后继续">Sign in to continue</a>
        <a class="button secondary" href="/pricing" data-zh="返回套餐">Back to plans</a>
      </div>
    </div>
  </section>
  <script>
    import { watchPayment, rememberPayment, rememberedPayment, clearRememberedPayment, paymentReturnOrder, shouldMonitorPayment } from "../lib/payment-sync.mjs";
    import { submitEpayForm } from "../lib/epay-form.mjs";
    import QRCode from "qrcode";
    import {uniquePaymentMethods,paymentMethodKey} from "../lib/payment-methods.mjs";
    import {packageSummary} from "../lib/package-summary.mjs";
    import {paymentActionLabel} from "../lib/payment-presentation.mjs";
    import { api, ApiError } from "../lib/api";
    import { checkoutOrderMessage, checkoutOrderFromError, mergeCheckoutRead, canUseCashierLink } from "../lib/checkout-status.mjs";
    import {checkoutResumeId,loadOrderCheckout} from "../lib/checkout-resume.mjs";
    import {safeMk99Cashier} from "../lib/payment-resume.mjs";
    type Channel="ALIPAY_H5"|"WECHAT_H5";
    type PaymentMethod={provider:"xiaodou"|"xiaodou_epay"|"mk99"|"local_mock";channel:Channel};
    type Package = { id:string; name_zh:string; name_en:string; credits:number; price_cents:number; promo_price_cents:number|null; currency:string; price_cny_fen:number|null; service_fee_fen:number|null; total_payment_fen:number|null; fee_rate_bps:number; merchant_pricing?:{feeBearer:string;rateBps:number;costCoverageFen:number;status:string}; description_zh?:string; description_en?:string };
    type Order = { id:string; packageId?:string; packageName:string; credits:number; displayPriceCents:number; displayCurrency:string; baseAmountFen:number; serviceFeeFen:number; feeRateBps:number; amountFen:number; currency:"CNY"; status:string; merchantPricing?:{feeBearer?:string;rateBps:number;costCoverageFen:number;status:string}|null; riskState?:string; creditedAt?:number|null; paymentProvider?:"xiaodou"|"xiaodou_epay"|"mk99"|"local_mock"; paymentProtocol?:"rsa2"|"epay"|"mk99"; paymentChannel?:Channel|null; paymentForm?:{action:string;method:string;fields:Record<string,string>}|null; paymentMode?:"mock"; paymentCashierOrigin?:string|null; paidAt?:number|null; paymentUrl?:string|null; paymentLinkUnavailable?:boolean; checkout?:{outcome:string;issue:string}|null; message?:string };
    type Quota = { freeRemaining:number; paidRemaining:number; totalRemaining:number };
    const pkgId = new URL(location.href).searchParams.get("package") || "";
    let invalidOrderLocator=false;
    let resumeOrderId="";
    try{resumeOrderId=checkoutResumeId(location.href,rememberedPayment())||"";}catch{invalidOrderLocator=true;}
    const label = (zh:string,en:string) => document.documentElement.lang === "en" ? en : zh;
    const byId = <T extends HTMLElement>(id:string) => document.getElementById(id) as T;
    let selected:Package|null = null;
    let paymentAvailable = false;
    let provider:"local_mock"|"xiaodou"|"xiaodou_epay"|"mk99"|null = null;
    let paymentMethods:PaymentMethod[]=[];
    let selectedChannel:Channel|null=null;
    let selectedProvider:PaymentMethod["provider"]|null=null;
    let order:Order|null = null;
    let busy = false;
    let restartAvailable = false;
    let confirmedMk99OrderId:string|null=null;
    let monitoredId:string|null=null;
    let renderedQrKey:string|null=null;
    let stopMonitoring=()=>{};
    async function syncConfirmedPayment(confirmed:Order){
      clearRememberedPayment(confirmed.id);
      try{const [,usage]=await Promise.all([api("/v1/me"),api<{quota:Quota}>("/v1/usage")]);byId("quota-result").hidden=false;byId("quota-result").textContent=label("付费余额："+usage.quota.paidRemaining+" 次 · 总余额："+usage.quota.totalRemaining+" 次","Paid balance: "+usage.quota.paidRemaining+" · Total: "+usage.quota.totalRemaining);setStatus(`支付成功，${confirmed.credits} 次额度已到账。`,`Payment successful. ${confirmed.credits} credits added.`);}
      catch{setStatus("支付已确认，账户信息暂时无法刷新，请稍后查看。","Payment confirmed; account refresh is temporarily unavailable.");}
    }
    function monitorPayment(next:Order){
      if(!shouldMonitorPayment(next)){stopMonitoring();monitoredId=null;return;}
      if(monitoredId===next.id)return;stopMonitoring();monitoredId=next.id;
      stopMonitoring=watchPayment({orderId:next.id,request:api,onPaid:async(result:any)=>{
        if(!order||order.id!==result.order.id)return;showOrder(mergeCheckoutRead(order,result.order));
        await syncConfirmedPayment(result.order);
      },onTimeout:()=>{monitoredId=null;setStatus("支付结果仍在确认，请稍后查看或手动刷新；不要重复付款。","Payment is still unconfirmed. Check later or refresh manually; do not pay again.");},onTerminal:(result:any)=>{if(order)showOrder(mergeCheckoutRead(order,result.order));},onError:(error:any)=>{if([401,403,404].includes(error?.status))setStatus("暂时无法读取订单，请登录对应账户后重试。","Cannot read this order. Sign in to the matching account.");}});
    }
    const setStatus = (zh:string,en:string) => { byId("checkout-status").textContent = label(zh,en); };
    function show(id:string,visible:boolean){byId(id).hidden=!visible;}
    async function renderWechatQr(next:Order){
      const image=byId<HTMLImageElement>("wechat-qr-image");
      const eligible=next.paymentProtocol==="rsa2"&&next.paymentChannel==="WECHAT_H5"&&next.status==="pending"&&typeof next.paymentUrl==="string";
      let safeUrl:URL|null=null;
      if(eligible){try{safeUrl=new URL(next.paymentUrl!);if(safeUrl.protocol!=="https:"||safeUrl.username||safeUrl.password)safeUrl=null;}catch{safeUrl=null;}}
      const visible=Boolean(eligible&&safeUrl);
      show("wechat-qr-panel",visible);show("wechat-mobile-note",visible);
      const key=visible?`${next.id}\n${next.paymentUrl}`:null;
      if(!key){renderedQrKey=null;image.src="";return;}
      if(renderedQrKey===key)return;
      renderedQrKey=key;
      try{
        const svg=await QRCode.toString(next.paymentUrl!,{type:"svg",width:240,margin:2,errorCorrectionLevel:"M"});
        if(renderedQrKey!==key||!order||order.id!==next.id||order.paymentUrl!==next.paymentUrl||order.status!=="pending")return;
        image.src=`data:image/svg+xml;charset=utf-8,${encodeURIComponent(svg)}`;
        image.alt=label("微信支付收银台二维码，请使用手机微信扫描","WeChat cashier QR code. Scan with your phone using WeChat.");
      }catch{
        renderedQrKey=null;show("wechat-qr-panel",false);show("wechat-mobile-note",false);
      }
    }
    function renderPaymentMethods(){
      const root=byId<HTMLDivElement>("payment-method-options");if(typeof root.replaceChildren==="function")root.replaceChildren();else root.innerHTML="";
      const unique=uniquePaymentMethods(paymentMethods) as PaymentMethod[];
      const choicesVisible=unique.length>0&&!order;
      show("checkout-payment-method",choicesVisible);
      if(!selectedChannel||!unique.some(method=>method.channel===selectedChannel&&method.provider===selectedProvider)){selectedChannel=unique[0]?.channel??null;selectedProvider=unique[0]?.provider??null;}
      for(const method of unique){
        const item=document.createElement("label");item.className="checkout-payment-option";
        const input=document.createElement("input");input.type="radio";input.name="payment-channel";input.value=paymentMethodKey(method);input.checked=method.channel===selectedChannel&&method.provider===selectedProvider;input.disabled=!paymentAvailable;
        input.addEventListener("change",()=>{selectedChannel=method.channel;selectedProvider=method.provider;renderPaymentMethods();});
        const text=document.createElement("strong");text.textContent=method.channel==="ALIPAY_H5"?"支付宝 Alipay":"微信支付 WeChat Pay";
        item.append(input,text);root.append(item);
      }
      byId("create-order-label").textContent=selectedChannel?paymentActionLabel(selectedChannel,"pay",document.documentElement.lang==="en"?"en":"zh"):label("暂不可付款","Payment unavailable");
      byId("epay-pay-text").textContent=paymentActionLabel("ALIPAY_H5","pay",document.documentElement.lang==="en"?"en":"zh");
      byId("cashier-link").textContent=paymentActionLabel(selectedChannel,"cashier",document.documentElement.lang==="en"?"en":"zh");
      byId("payment-method-note").textContent=selectedProvider==="mk99"?label("前往收银台按渠道引导完成付款。实际支付币种为人民币 CNY。","Follow the cashier instructions for your payment method. Your payment is charged in CNY."):selectedChannel==="WECHAT_H5"?label("微信支付需要在微信内打开收银台完成支付；其他浏览器请按收银台引导操作。","WeChat Pay works in the WeChat browser. In other browsers, follow the cashier's instructions."):selectedChannel==="ALIPAY_H5"?label("前往收银台，使用支付宝完成付款。实际支付币种为人民币 CNY。","Continue to the cashier and pay with Alipay. Your payment is charged in CNY."):label("当前没有已放行的支付方式，暂时无法创建新订单。","No currently released payment methods; new orders are unavailable.");
    }
    function render(){
      const restartableOrder=order?.paymentProtocol==="epay"&&["pending","unknown","failed","closed","expired"].includes(order.status);
      const rejectedUnresolvedOrder=!order&&restartAvailable&&selectedProvider==="xiaodou_epay";
      const canRestart=paymentAvailable&&paymentMethods.some(method=>method.provider==="xiaodou_epay")&&(restartableOrder||rejectedUnresolvedOrder);
      show("restart-payment",canRestart);show("restart-notice",canRestart);byId<HTMLButtonElement>("restart-payment").disabled=busy;
      if(!selected){byId("package-name").textContent=label("套餐不存在或已下架。","Package not found or unavailable.");return;}
      byId("package-name").textContent=document.documentElement.lang==="en"?selected.name_en:selected.name_zh;
      byId("package-credits").textContent=label("AI 生成次数："+selected.credits.toLocaleString()+" 次","AI generations: "+selected.credits.toLocaleString());
      byId("package-usd").textContent=label("美元价格：$"+((selected.promo_price_cents??selected.price_cents)/100).toFixed(2),"USD price: $"+((selected.promo_price_cents??selected.price_cents)/100).toFixed(2));
      byId("package-description").textContent=(document.documentElement.lang==="en"?selected.description_en:selected.description_zh)||"";
      const pricingSummary=packageSummary(selected,document.documentElement.lang==="en"?"en":"zh");
      byId("package-fee").textContent=pricingSummary.fee;
      byId("package-cny").textContent=pricingSummary.cny||label("该套餐暂未配置人民币结算价。","This package has no CNY settlement price yet.");
      renderPaymentMethods();
          byId("create-order").disabled=busy||!paymentAvailable||!selected.total_payment_fen||Boolean(order);
    }
    function showOrder(next:Order){
      order=next;render();monitorPayment(next);
      void renderWechatQr(next);
      byId("checkout-status").textContent=checkoutOrderMessage(next,document.documentElement.lang);
      byId("package-fee").textContent=packageSummary({fee_rate_bps:next.feeRateBps,merchant_pricing:next.merchantPricing},document.documentElement.lang==="en"?"en":"zh").fee;
      byId("package-cny").textContent=label("人民币实付：¥"+(next.amountFen/100).toFixed(2)+" CNY","CNY payment due: ¥"+(next.amountFen/100).toFixed(2)+" CNY");
      byId("payment-method-note").textContent=next.paymentChannel==="WECHAT_H5"?label("微信支付订单；请按收银台支持的终端方式完成付款。","WeChat Pay order. Follow the cashier's supported device flow."):label("支付宝订单；请在收银台核对金额后付款。","Alipay order. Confirm the amount in the cashier before paying.");
      byId("cashier-link").textContent=paymentActionLabel(next.paymentChannel??null,"cashier",document.documentElement.lang==="en"?"en":"zh");
      const mk99=next.paymentProtocol==="mk99";
      const cashierAllowed=canUseCashierLink(next)&&(!mk99||(confirmedMk99OrderId===next.id&&Boolean(safeMk99Cashier(next,next.id))));
      show("cashier-link",cashierAllowed);byId<HTMLAnchorElement>("cashier-link").href=cashierAllowed?next.paymentUrl!:"";
      if(mk99&&next.status==="paid"&&!next.creditedAt)setStatus("付款已确认，额度到账仍待核对，请勿再次付款。","Payment is confirmed; credit settlement is still being checked. Do not pay again.");
      show("epay-submit",next.paymentProtocol==="epay"&&next.status==="pending"&&paymentAvailable);
      byId<HTMLButtonElement>("epay-submit").disabled=busy;
      show("epay-pay-label",Boolean(next.paymentForm));show("epay-restore-label",!next.paymentForm);
      show("simulate-payment",next.paymentMode==="mock"&&next.status==="pending");
      show("refresh-order",next.status==="unknown"||(next.status==="pending"&&(next.paymentProtocol==="rsa2"||next.paymentProtocol==="epay"||next.paymentProtocol==="mk99")));
      show("relaunch-rsa2",next.paymentProtocol==="rsa2"&&["pending","unknown"].includes(next.status));
      byId<HTMLButtonElement>("relaunch-rsa2").disabled=busy;
      show("create-order",false);
    }
    async function load(){
      try{
        if(invalidOrderLocator){setStatus("订单编号无效，请从账户页面重新打开原订单。","Invalid order ID. Open the original order from your account.");return;}
        const data=await api<{packages:Package[];paymentAvailable:boolean;paymentProvider:"local_mock"|"xiaodou"|"xiaodou_epay"|"mk99"|null;paymentMethods?:PaymentMethod[]}>("/v1/packages");
        selected=data.packages.find(item=>item.id===pkgId)||null;paymentAvailable=data.paymentAvailable;provider=data.paymentProvider;paymentMethods=data.paymentMethods??[];selectedChannel=paymentMethods[0]?.channel??null;
        if(resumeOrderId){
          const saved=await loadOrderCheckout(resumeOrderId,api);
          confirmedMk99OrderId=saved.verified?resumeOrderId:null;
          const o=saved.order as Order;
          selected={id:o.packageId||"",name_zh:o.packageName,name_en:o.packageName,credits:o.credits,price_cents:o.displayPriceCents,promo_price_cents:null,currency:"USD",price_cny_fen:o.baseAmountFen,service_fee_fen:o.serviceFeeFen,total_payment_fen:o.amountFen,fee_rate_bps:o.feeRateBps,merchant_pricing:o.merchantPricing??undefined};
          showOrder(o);if(o.status==="paid"&&o.creditedAt)await syncConfirmedPayment(o);return;
        }
        render();
        if(!selected){setStatus("套餐不存在或已下架。","Package not found or unavailable.");return;}
        if(!paymentAvailable)setStatus("支付暂未开放，目前不能创建订单。","Checkout is not open yet; an order cannot be created.");
        else if(provider==="local_mock")setStatus("本地模拟支付仅用于开发，不会扣款。","Local mock checkout is for development only; it will not charge you.");
      }catch(error){if(error instanceof ApiError&&error.status===401)show("login-link",true);setStatus(resumeOrderId?"无法读取原订单，请确认登录账户后重试或联系客服。":"暂时无法读取套餐，请稍后重试。",resumeOrderId?"Cannot read the original order. Check the signed-in account, retry or contact support.":"Unable to load packages. Please retry later.");}
    }
    // Read only our package endpoint on return to this page; existing order monitoring stays independent.
    let availabilityTimer:ReturnType<typeof setTimeout>|null=null;
    let availabilityInFlight=false;
    async function refreshAvailability(){
      if(document.visibilityState!=="visible"||availabilityInFlight)return;
      availabilityInFlight=true;
      try{
        const data=await api<{packages:Package[];paymentAvailable:boolean;paymentProvider:typeof provider;paymentMethods?:PaymentMethod[]}>("/v1/packages");
        const changed=paymentAvailable!==data.paymentAvailable;
        paymentAvailable=data.paymentAvailable;
        paymentMethods=data.paymentMethods??[];
        // A closed switch must not erase the provider needed by an existing order's manual refresh.
        if(data.paymentProvider)provider=data.paymentProvider;
        else if(!order)provider=null;
        if(!order)selected=data.packages.find(item=>item.id===pkgId)||null;
        if(order){
          const canRestart=paymentAvailable&&order.paymentProtocol==="epay"&&paymentMethods.some(method=>method.provider==="xiaodou_epay")&&(restartAvailable||["pending","unknown","failed","closed","expired"].includes(order.status));
          show("restart-payment",canRestart);show("restart-notice",canRestart);
          show("epay-submit",order.paymentProtocol==="epay"&&order.status==="pending"&&paymentAvailable);
          showOrder(order);
        }else render();
        if(!order&&changed)setStatus(paymentAvailable?"支付已开放，可以创建订单。":"支付暂未开放，目前不能创建订单。",paymentAvailable?"Checkout is available. You can create an order.":"Checkout is not open yet; an order cannot be created.");
      }catch{
        paymentAvailable=false;
        if(!order)render();
        show("restart-payment",false);show("restart-notice",false);show("epay-submit",false);
      }finally{availabilityInFlight=false;}
    }
    function scheduleAvailabilityRefresh(){
      if(document.visibilityState!=="visible")return;
      if(availabilityTimer)clearTimeout(availabilityTimer);
      availabilityTimer=setTimeout(()=>{availabilityTimer=null;void refreshAvailability();},250);
    }
    window.addEventListener("focus",scheduleAvailabilityRefresh);
    document.addEventListener("visibilitychange",scheduleAvailabilityRefresh);
    async function startOrder(restart=false){
      if(!selected||busy||(!restart&&order)||!paymentAvailable)return;
      if(restart&&(order?order.paymentProtocol!=="epay":selectedProvider!=="xiaodou_epay"))return;
      busy=true;render();setStatus("正在创建订单…","Creating order…");let failureMessage:string|null=null;
      try{const result=await api<{order:Order}>("/v1/orders",{method:"POST",body:JSON.stringify({packageId:selected.id,...(!restart&&selectedChannel?{provider:selectedProvider,channel:selectedChannel}:{}),...(restart?{restartPayment:true}:{})})});restartAvailable=false;showOrder(result.order);
        if(result.order.paymentProtocol==="mk99"&&result.order.status==="pending"){
          const saved=await api<{order:Order}>("/v1/orders/"+encodeURIComponent(result.order.id));
          if(saved.order.id!==result.order.id)throw new Error("ORDER_MISMATCH");
          const latest=mergeCheckoutRead(order,saved.order) as Order;
          confirmedMk99OrderId=safeMk99Cashier(latest,result.order.id)?latest.id:null;showOrder(latest);
        }else showOrder(result.order);}
      catch(error){const saved=checkoutOrderFromError(error);if(saved)showOrder(saved as Order);else if(error instanceof ApiError&&error.status===401){show("login-link",true);failureMessage=label("请先登录官网账户，再继续充值。","Sign in to your website account to continue.");}else{if(error instanceof ApiError&&error.code==="UNRESOLVED_ORDER_EXISTS")restartAvailable=selectedProvider==="xiaodou_epay";failureMessage=error instanceof ApiError&&error.code==="UNRESOLVED_ORDER_EXISTS"&&selectedProvider!=="xiaodou_epay"?"UNRESOLVED_ORDER_EXISTS":error instanceof Error?error.message:label("订单创建失败，请稍后重试。","Could not create order. Please retry.");}}
      finally{busy=false;render();if(order)showOrder(order);if(failureMessage&&failureMessage.includes("UNRESOLVED_ORDER_EXISTS"))failureMessage=label("该套餐已有待付款或待确认订单，请先确认原订单状态。其他套餐仍可购买。","This package has an unpaid or unconfirmed order. Check the original order first. Other packages can still be purchased.");if(failureMessage)byId("checkout-status").textContent=failureMessage;}
    }
    byId("create-order").addEventListener("click",()=>{void startOrder();});
    byId("restart-payment").addEventListener("click",()=>{void startOrder(true);});
    // Ordinary checkout keeps the original user-initiated native new-tab link.
    // Existing-order recovery has its own async reconciliation path; never replace
    // this navigation with location.assign after awaiting a query.
    byId("cashier-link").addEventListener("click",(event)=>{
      if(order?.paymentProtocol==="mk99"){
        const latest=order;
        const url=confirmedMk99OrderId===latest.id?safeMk99Cashier(latest,latest.id):null;
        const anchor=event.currentTarget as HTMLAnchorElement;
        if(busy||!url||anchor.getAttribute("href")!==url){
          event.preventDefault();show("cashier-link",false);
          setStatus("付款状态已变化，请刷新订单状态后再试。","Payment state has changed. Refresh the order status before trying again.");return;
        }
        try{rememberPayment(latest.id);}catch{event.preventDefault();setStatus("无法保存付款跟踪状态，请稍后重试。","Unable to save payment tracking. Please retry.");}
        return;
      }
      if(order&&order.paymentProtocol==="rsa2"&&order.status==="pending")rememberPayment(order.id);
    });
    byId("epay-submit").addEventListener("click",async()=>{
      if(busy||!order||order.paymentProtocol!=="epay"||order.status!=="pending"||!paymentAvailable)return;
      busy=true;byId<HTMLButtonElement>("epay-submit").disabled=true;
      try{
        if(!order.paymentForm){
          const restored=await api<{paymentForm:NonNullable<Order["paymentForm"]>}>("/v1/orders/"+encodeURIComponent(order.id)+"/attempts",{method:"POST",body:"{}"});
          order={...order,paymentForm:restored.paymentForm};busy=false;showOrder(order);
          setStatus("原订单付款表单已恢复，请核对金额后点击前往支付宝；不要重复提交。","The same order form is restored. Check the amount before continuing to Alipay; do not submit twice.");return;
        }
        rememberPayment(order.id);
        submitEpayForm(order.paymentForm);
      }
      catch(error){busy=false;byId<HTMLButtonElement>("epay-submit").disabled=false;setStatus(error instanceof Error?error.message:label("付款表单不可用，请保留订单联系支持，不要重新下单。","The checkout form is unavailable. Keep this order and contact support; do not place another order."));}
    });
    // RSA2 can resume an old order without creating a second purchase. The
    // backend uses the Xiaodou attempts endpoint and preserves its order ID.
    byId("relaunch-rsa2").addEventListener("click",async()=>{
      if(busy||!order||order.paymentProtocol!=="rsa2"||!["pending","unknown"].includes(order.status))return;
      const original=order;busy=true;
      byId<HTMLButtonElement>("relaunch-rsa2").disabled=true;
      show("cashier-link",false);
      setStatus("正在确认原订单并生成新的付款入口…","Checking original order and generating a new cashier…");
      try{
        const attempt=await api<{ok:boolean;orderStatus:string;paymentUrl:string|null;checkout?:Order["checkout"]}>(`/v1/orders/${encodeURIComponent(original.id)}/attempts`,{method:"POST",body:"{}"});
        const read=await api<{order:Order}>(`/v1/orders/${encodeURIComponent(original.id)}`);
        if(read.order.id!==original.id)throw new Error("ORDER_MISMATCH");
        if(read.order.status!=="pending"){showOrder(read.order);setStatus("原订单状态已变化，请查验支付状态。","Original order status changed. Check payment status.");return;}
        const fresh={...read.order,paymentUrl:attempt.paymentUrl,checkout:attempt.checkout??read.order.checkout};
        if(!attempt.ok||attempt.orderStatus!=="pending"||!canUseCashierLink(fresh))
          throw new Error("PAYMENT_CASHIER_UNCONFIRMED");
        showOrder(fresh);
        setStatus("新的原订单付款入口已生成，旧二维码请勿再使用。","A fresh cashier for the same order is ready. Do not reuse the previous QR code.");
      }catch(error){
        show("cashier-link",false);
        if(error instanceof ApiError&&error.code==="PROVIDER_HTTP_ERROR"){
          setStatus("小豆平台查单返回上游错误，原订单已保留；请稍后再查验，勿重复下单或付款。","Xiaodou's order query returned an upstream error. Your original order remains unchanged; do not retry payment blindly.");
        }else{
          setStatus("新付款入口暂无法确认，请先刷新原订单状态，勿重复创建订单。","Could not confirm a new cashier. Refresh the original order; do not create another purchase.");
        }
      }finally{busy=false;byId<HTMLButtonElement>("relaunch-rsa2").disabled=false;}
    });
    byId("simulate-payment").addEventListener("click",async()=>{
      if(!order||busy)return;busy=true;show("simulate-payment",false);setStatus("正在模拟本地支付…","Simulating local payment…");
      try{await api("/v1/dev/orders/"+encodeURIComponent(order.id)+"/simulate-payment",{method:"POST",body:JSON.stringify({eventId:"local-"+crypto.randomUUID()})});const result=await api<{order:Order;quota:Quota}>("/v1/orders/"+encodeURIComponent(order.id));showOrder(result.order);byId("quota-result").hidden=false;byId("quota-result").textContent=label("付费余额："+result.quota.paidRemaining+" 次 · 总余额："+result.quota.totalRemaining+" 次","Paid balance: "+result.quota.paidRemaining+" · Total: "+result.quota.totalRemaining);}
      catch(error){setStatus(error instanceof Error?error.message:label("模拟支付失败，请重试。","Mock payment failed. Retry."));show("simulate-payment",true);}
      finally{busy=false;}
    });
    byId("refresh-order").addEventListener("click",async()=>{
      if(!order||busy)return;busy=true;byId<HTMLButtonElement>("refresh-order").disabled=true;
      if(order.paymentProtocol==="mk99"){confirmedMk99OrderId=null;show("cashier-link",false);}
      setStatus("正在查询支付状态…","Checking payment status…");
      let failure=false;
      try{
        if(order.paymentProtocol==="mk99"){
          const result=await loadOrderCheckout(order.id,api,{queryUnknown:true});confirmedMk99OrderId=result.verified?order.id:null;
          showOrder(mergeCheckoutRead(order,result.order) as Order);
          if(result.order.status==="paid"&&result.order.creditedAt)await syncConfirmedPayment(result.order as Order);
        }else{
          if(order.paymentProtocol==="rsa2")await api("/v1/orders/"+encodeURIComponent(order.id)+"/refresh",{method:"POST",body:"{}"});
          const result=await api<{order:Order;quota:Quota}>("/v1/orders/"+encodeURIComponent(order.id));showOrder(mergeCheckoutRead(order,result.order));
          if(result.order.status==="paid"&&result.order.creditedAt)await syncConfirmedPayment(result.order);
        }
      }catch{failure=true;}
      finally{busy=false;byId<HTMLButtonElement>("refresh-order").disabled=false;if(order)showOrder(order);if(failure)setStatus("无法确认支付状态，请稍后重试或联系客服，不要重复付款。","Payment status could not be confirmed. Retry later or contact support; do not pay again.");}
    });
    window.addEventListener("pageshow",()=>{busy=false;render();if(order){showOrder(order);if(["pending","unknown"].includes(order.status))setStatus("正在确认支付结果…","Confirming payment…");}});
    void load();window.addEventListener("reply-copilot-language",()=>{render();if(order)showOrder(order);});
  </script>
</Base>
