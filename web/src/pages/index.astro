---
import Base from "../layouts/Base.astro";
---
<Base title="互动势能临界值 · X 创作者增长研究" titleEn="Creator Momentum Threshold · X creator growth research" description="原创帖的传播机会，并不只取决于发布的那一刻。探索互动势能临界值与 X Reply Helper 创作者工具。">
  <!-- First fold: the founder's thesis is the product's central brand idea. -->
  <section id="creator-momentum" class="momentum-v2-landing" aria-labelledby="momentum-v2-title">
    <div class="container momentum-v2-shell">
      <div class="momentum-v2-eyebrow">
        <span class="momentum-v2-pulse" aria-hidden="true"></span>
        <span>X REPLY HELPER / CREATOR MOMENTUM</span>
        <span class="momentum-v2-pro">PRO</span>
      </div>
      <div class="momentum-v2-grid">
        <div class="momentum-v2-copy">
          <div class="momentum-v2-overline"><span data-zh="原创理论 · CREATOR MOMENTUM THRESHOLD">ORIGINAL FRAMEWORK · CREATOR MOMENTUM THRESHOLD</span></div>
          <h1 id="momentum-v2-title">
            <span data-zh="互动势能">Creator</span>
            <span class="momentum-v2-heading-accent" data-zh="临界值。">Momentum.</span>
          </h1>
          <div class="momentum-v2-claim">
            <span class="momentum-v2-quote-mark" aria-hidden="true">“</span>
            <p data-zh="我认为，原创帖的传播机会，并不只取决于发布的那一刻。">I believe an original post's reach is shaped by more than the moment it's published.</p>
          </div>
          <p class="momentum-v2-lead" data-zh="X Reply Helper 帮你更自然地参与高质量讨论；互动势能临界值引擎，则探索互动积累与原创传播窗口之间的关系。一套工具，从回复开始，为原创蓄势。">X Reply Helper helps you join meaningful conversations in your own voice. Creator Momentum explores how accumulated engagement may relate to promising moments for original posts. Two capabilities, one creator workflow.</p>
          <div class="momentum-v2-actions">
            <a href="/account/" data-reply-assistant-cta class="button momentum-v2-primary">
              <span data-zh="免费体验 AI 回复助手">Start with AI replies</span>
              <span aria-hidden="true">↗</span>
            </a>
            <a href="#momentum-framework" class="button secondary momentum-v2-secondary">
              <span data-zh="了解互动势能理论">Explore the theory</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
          <div class="momentum-v2-signature">
            <span class="momentum-v2-signature-line" aria-hidden="true"></span>
            <span data-zh="互动是蓄势 · 临界是信号 · 原创是释放">ENGAGE · DETECT · RELEASE</span>
          </div>
        </div>
        <div class="momentum-v2-device" aria-label="Creator Momentum conceptual threshold research visualization">
          <div class="momentum-v2-device-bar">
            <div class="momentum-v2-device-brand"><span class="momentum-v2-brand-mark">✦</span><div><strong>X REPLY HELPER</strong><small data-zh="创作者双引擎工作台">CREATOR WORKSPACE / TWO ENGINES</small></div></div>
            <div class="momentum-v2-device-state"><span></span> SIGNAL MAP</div>
          </div>
          <div class="momentum-v2-display">
            <div class="momentum-v2-chart-title"><span><b class="mv2-engine-code">01</b> <span data-zh="互动势能 · 临界信号研究">MOMENTUM / THRESHOLD SIGNALS</span></span><span>01 — 03</span></div>
            <svg class="momentum-v2-chart" viewBox="0 0 520 290" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Conceptual rising engagement momentum curve with a threshold transition and publishing window">
              <defs>
                <linearGradient id="mv2-line" x1="0" y1="1" x2="1" y2="0"><stop stop-color="#6186f4"/><stop offset=".56" stop-color="#9bbaff"/><stop offset="1" stop-color="#7ce8eb"/></linearGradient>
                <linearGradient id="mv2-fill" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#477df8" stop-opacity=".32"/><stop offset="1" stop-color="#477df8" stop-opacity="0"/></linearGradient>
                <filter id="mv2-glow"><feGaussianBlur stdDeviation="5"/></filter>
              </defs>
              <path d="M20 245H504M20 188H504M20 131H504M20 74H504" stroke="#6d84ae" stroke-opacity=".16"/>
              <path d="M20 36V260M110 36V260M200 36V260M290 36V260M380 36V260M470 36V260" stroke="#6d84ae" stroke-opacity=".11"/>
              <path d="M24 243 C106 239 154 224 216 216 S294 185 331 155 S409 78 489 35 L489 260 L24 260 Z" fill="url(#mv2-fill)"/>
              <path d="M24 243 C106 239 154 224 216 216 S294 185 331 155 S409 78 489 35" stroke="#4678ee" stroke-opacity=".5" stroke-width="12" filter="url(#mv2-glow)" fill="none"/>
              <path d="M24 243 C106 239 154 224 216 216 S294 185 331 155 S409 78 489 35" stroke="url(#mv2-line)" stroke-width="4.5" stroke-linecap="round" fill="none"/>
              <path d="M331 39V260" stroke="#82b7f8" stroke-width="1.7" stroke-dasharray="5 7" stroke-opacity=".62"/>
              <circle cx="331" cy="155" r="16" fill="#608afd" fill-opacity=".26"/><circle cx="331" cy="155" r="6" fill="#b9d7ff"/>
              <circle cx="489" cy="35" r="10" fill="#7ce8eb" fill-opacity=".2"/><circle cx="489" cy="35" r="4.5" fill="#b3ffff"/>
              <rect x="272" y="102" width="126" height="31" rx="9" fill="#294b8c" stroke="#507bbb"/>
              <text x="335" y="123" text-anchor="middle" font-size="11" fill="#e1ecff" font-family="sans-serif" font-weight="700">THRESHOLD</text>
              <text x="30" y="277" font-size="10" fill="#90aed9" font-family="sans-serif">ENGAGEMENT</text>
              <text x="406" y="277" font-size="10" fill="#9fdde9" font-family="sans-serif">RELEASE</text>
            </svg>
            <div class="momentum-v2-reply-module" aria-label="Illustrative AI reply assistant preview">
              <div class="mv2-reply-head">
                <span><b class="mv2-engine-code mv2-reply-code">02</b> <span data-zh="AI 回复助手 · 实用功能">AI REPLY ASSISTANT</span></span>
                <span class="mv2-reply-badge">AI · X</span>
              </div>
              <div class="mv2-reply-content">
                <div class="mv2-reply-original">
                  <span class="mv2-reply-avatar">X</span>
                  <p data-zh="“坚持做有价值的事，真的能被看见吗？”">“Does showing up consistently ever pay off?”</p>
                </div>
                <div class="mv2-reply-draft">
                  <div class="mv2-reply-choices"><span data-zh="自然">Natural</span><span data-zh="幽默">Playful</span><span data-zh="观点">Thoughtful</span></div>
                  <p data-zh="有人看到之前，先别停止。真正的区别是那些安静的日子里，你还在继续。">Even before anyone notices, keep going. The quiet days make the difference.</p>
                  <span class="mv2-reply-disclaimer" data-zh="示意草稿 · 由你确认发送">Illustrative draft · You decide to send</span>
                </div>
              </div>
            </div>
          </div>
          <div class="momentum-v2-device-foot"><span class="momentum-v2-foot-dot" aria-hidden="true"></span><span data-zh="多维信号 · 互动时序 · 非线性临界">MULTI-SIGNAL · TIME SERIES · NONLINEARITY</span><span class="mv2-foot-star" aria-hidden="true">✧</span></div>
        </div>
      </div>
      <div class="momentum-v2-value-bar">
        <div><span>01 / ENGAGE</span><strong data-zh="高质量互动积累">Quality engagement</strong><small data-zh="话题关联与受众连接">Topic and audience connections</small></div>
        <div><span>02 / DETECT</span><strong data-zh="非线性临界识别">Inflection detection</strong><small data-zh="时序行为信号研究">Time-series signal analysis</small></div>
        <div><span>03 / RELEASE</span><strong data-zh="原创发布窗口">Original publishing window</strong><small data-zh="值得尝试的关键时刻">A meaningful moment to publish</small></div>
      </div>
      <div class="momentum-v2-bottom-link"><span data-zh="创始人理论 × AI 创作者工具">FOUNDER'S FRAMEWORK × CREATOR TOOLING</span><a href="#reply-assistant" data-zh="了解 X 回复助手 ↓">Discover the reply assistant ↓</a></div>
    </div>
  </section>
  <div id="reply-assistant" class="container home-product-section-title">
    <div class="home-product-section-eyebrow"><span data-zh="01 / 从每次真实讨论开始">01 / YOUR EVERYDAY TOOL</span></div>
    <h2 data-zh="把每一次回复，变成一次更好的表达。">Every reply deserves your real voice.</h2>
    <p data-zh="互动势能从真实讨论中积累。X Reply Helper 让你更轻松地参与值得参与的对话。">Meaningful momentum begins in real conversations. X Reply Helper helps you find your voice in each one.</p>
  </div>

  <section class="container hero home-hero" aria-labelledby="home-heading">
    <div class="home-hero-glow" aria-hidden="true"></div>
    <div>
      <div class="eyebrow home-hero-eyebrow"><span class="hero-eyebrow-dot" aria-hidden="true"></span><span data-site-text="homeSubtitle" data-zh="适用于 X 创作者的回复助手">Thoughtful replies for X</span></div>
      <h1 id="home-heading"><span data-site-text="homeTitle" data-zh="让你的每条 X 回复，更像你自己。">Make every X reply sound more like you.</span></h1>
      <p class="lead"><span data-site-text="homeBody" data-zh="读懂对话，参考你的写作风格，生成自然、幽默或有观点的回复草稿。你可以修改、复制或填入 X 回复框，发送始终由你决定。">x-Reply-Helper reads the conversation and your writing style to suggest natural, playful, or thoughtful drafts. Edit and send only when they feel right.</span></p>
      <div class="hero-actions"><a class="button" data-site-primary href="/guide" data-site-text="homeCta" hidden></a><a class="button" data-default-primary data-account-cta href="/login?mode=register" hidden><span data-zh="免费领取 200 次">Get 200 free generations</span> →</a><a class="button secondary" data-site-internal="homeSecondaryCtaHref" href="/guide"><span data-site-text="homeSecondaryCta" data-zh="了解如何使用">How it works</span></a><a class="button momentum-hero-link" href="#creator-momentum"><span data-zh="探索互动势能">Explore Creator Momentum</span><span aria-hidden="true">↗</span></a></div>
      <p class="fineprint"><span data-zh="无需 API Key · 无需信用卡 · 免费额度不主动过期">No API key · No credit card · Free credits do not expire</span></p>
    </div>
    <div class="product-frame home-product-preview" aria-label="Illustrative product preview">
      <div class="frame-head"><span>● ● ● &nbsp; x.com</span><span data-zh="示意界面，非真实录屏">Illustrative preview · not a video</span></div>
      <div class="frame-post"><span class="avatar">A</span><strong>@alexbuilds</strong><p style="margin:14px 0 0" data-zh="做产品最难的部分，不是开始，而是每天回来再做一点。">The hardest part of building isn't starting. It's showing up again tomorrow.</p></div>
      <div class="reply-card"><div class="reply-card-head"><img class="brand-mark" src="/favicon.svg" alt="" /><strong data-zh="x-Reply-Helper · 建议草稿">x-Reply-Helper · Suggested draft</strong></div><div class="reply-tabs"><span data-zh="自然">Natural</span><span data-zh="幽默">Playful</span><span data-zh="观点">Thoughtful</span></div><p style="line-height:1.7;margin:0" data-zh="太真实了。真正拉开差距的，往往就是那些没人看见、但你还是继续做的日子。">This hits. The quiet days when nobody's watching are usually where the real progress happens.</p><div class="preview-actions"><span data-zh="换一个">Regenerate</span><span data-zh="复制">Copy</span><span data-zh="填入回复框">Fill reply</span></div><div class="fineprint" style="margin-top:14px" data-zh="产品交互示意 · 草稿可编辑 · 发送由你决定">Illustrative preview · Editable draft · You choose whether to send</div></div>
    </div>
  </section>
  <div class="benefit-bar"><div class="container benefit-inner"><span data-zh="新用户获赠 200 次">200 credits for new users</span><span data-zh="一次生成，三种风格">Three styles per generation</span><span data-zh="只在确认后发送">You decide when to post</span></div></div>

  <section id="momentum-framework" class="momentum-showcase" aria-labelledby="momentum-heading">
    <div class="container momentum-container">
      <div class="momentum-head">
        <div class="momentum-kicker"><span class="momentum-status-dot" aria-hidden="true"></span><span data-zh="原创理论 · CREATOR MOMENTUM">ORIGINAL FRAMEWORK · CREATOR MOMENTUM</span></div>
        <h2 id="momentum-heading"><span data-zh="互动势能临界值">Creator Momentum Threshold</span><span class="momentum-heading-mark" aria-hidden="true">⚡</span></h2>
        <p class="momentum-subtitle" data-zh="真正的原创影响力，也许从你参与的每一次讨论就已经开始。">The next original post may begin with every meaningful conversation you have today.</p>
      </div>
      <div class="momentum-layout">
        <div class="momentum-narrative">
          <div class="momentum-author-label"><span class="momentum-author-line" aria-hidden="true"></span><span data-zh="创始人提出的传播势能理论">A founder-defined theory of distribution momentum</span></div>
          <p class="momentum-opening" data-zh="我认为，原创帖的传播机会，并不只取决于发布的那一刻。">I believe an original post's distribution opportunity is shaped by more than the moment it is published.</p>
          <p data-zh="持续参与高质量讨论，可能让账号逐渐建立话题关联、受众连接与行为信号，形成潜在的传播势能。">Sustained participation in meaningful conversations may help an account build topic relevance, audience connections, and behavioral signals that contribute to potential distribution momentum.</p>
          <p data-zh="我将这种互动积累过程中，可能出现传播条件非线性变化的关键节点，定义为「互动势能临界值」。">I call the point at which accumulated engagement may correspond to a nonlinear shift in distribution conditions the “Creator Momentum Threshold.”</p>
          <div class="momentum-research-divider"><span data-zh="研究框架 / RESEARCH FRAMEWORK">RESEARCH FRAMEWORK / THEORY</span></div>
          <p data-zh="互动势能分析引擎融合 X 推荐机制研究、互动时序建模、传播趋势分析及中文区创作者X榜单，构建多维势能评估体系。">The Creator Momentum Analysis Engine brings together research on X's recommendation mechanisms, engagement time-series modeling, distribution trends, and Chinese-language creator rankings to develop a multidimensional momentum assessment framework.</p>
          <p data-zh="通过每日动态数据更新、历史样本数据库积累与持续模型训练分析，不断优化行为信号权重与临界策略，探索互动积累和原创内容曝光表现之间的潜在关联。">Through daily data updates, historical sample accumulation, and ongoing model training and analysis, the framework aims to refine behavioral signal weights and threshold strategies, exploring potential relationships between engagement accumulation and original-post impressions.</p>
          <p data-zh="系统通过分阶段临界识别，辅助捕捉值得尝试原创发布的关键窗口。">Staged threshold detection helps identify promising windows to consider publishing original content.</p>
          <p class="momentum-signature" data-zh="互动是蓄势，临界是信号，原创是释放。">Engagement builds momentum. Thresholds signal opportunity. Original posts release it.</p>
          <div class="momentum-actions">
            <a class="button momentum-cta" href="/pricing"><span data-zh="探索 PRO 功能">Explore PRO features</span><span aria-hidden="true">↗</span></a>
            <span class="momentum-pro-note" data-zh="专为 X 创作者设计">Made for creators on X</span>
          </div>
        </div>
        <div class="momentum-visual">
          <div class="momentum-visual-top"><span class="momentum-indicator"></span><span data-zh="势能研究模型">MOMENTUM RESEARCH MODEL</span><span class="momentum-visual-number">01—03</span></div>
          <div class="momentum-chart" role="img" aria-label="互动信号累积、非线性临界点和原创发布窗口的概念图">
            <div class="momentum-chart-grid" aria-hidden="true"></div>
            <svg class="momentum-curve" viewBox="0 0 600 310" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
              <defs>
                <linearGradient id="momentum-line" x1="0" y1="1" x2="1" y2="0">
                  <stop offset="0%" stop-color="#7ca4ff"/><stop offset="54%" stop-color="#9dbaff"/><stop offset="100%" stop-color="#60c9f7"/>
                </linearGradient>
                <linearGradient id="momentum-fill" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#799cff" stop-opacity=".24"/><stop offset="100%" stop-color="#799cff" stop-opacity="0"/>
                </linearGradient>
              </defs>
              <path d="M26 270 C100 265 145 245 211 239 S325 215 365 183 S451 95 572 35 L572 292 L26 292 Z" fill="url(#momentum-fill)"/>
              <path d="M26 270 C100 265 145 245 211 239 S325 215 365 183 S451 95 572 35" fill="none" stroke="url(#momentum-line)" stroke-width="5" stroke-linecap="round"/>
              <path d="M365 183 V292" stroke="#80b7f3" stroke-opacity=".48" stroke-dasharray="5 7" stroke-width="2"/>
              <circle cx="365" cy="183" r="12" fill="#99c5ff" fill-opacity=".14"/><circle cx="365" cy="183" r="5" fill="#b2e4ff"/>
              <circle cx="572" cy="35" r="9" fill="#60c9f7" fill-opacity=".16"/><circle cx="572" cy="35" r="4" fill="#a7eaff"/>
            </svg>
            <div class="momentum-chart-label momentum-chart-label-left">SIGNALS</div>
            <div class="momentum-chart-label momentum-chart-label-mid">THRESHOLD</div>
            <div class="momentum-chart-label momentum-chart-label-right">PUBLISH</div>
          </div>
          <div class="momentum-stage-list">
            <div class="momentum-stage"><span class="stage-index">01</span><div><strong data-zh="互动积累">Engagement accumulation</strong><p data-zh="话题关联 · 行为信号">Topic relevance · Behavioral signals</p></div><span class="stage-symbol" aria-hidden="true">↗</span></div>
            <div class="momentum-stage"><span class="stage-index">02</span><div><strong data-zh="临界识别">Threshold detection</strong><p data-zh="互动时序 · 非线性变化">Time series · Nonlinear shifts</p></div><span class="stage-symbol" aria-hidden="true">⌁</span></div>
            <div class="momentum-stage"><span class="stage-index">03</span><div><strong data-zh="原创窗口">Original publishing window</strong><p data-zh="阶段信号 · 发布提醒">Stage signals · Publishing cues</p></div><span class="stage-symbol" aria-hidden="true">↗</span></div>
          </div>
          <div class="momentum-caption"><span data-zh="互动是蓄势">ENGAGEMENT</span><span class="caption-arrow">→</span><span data-zh="临界是信号">THRESHOLD</span><span class="caption-arrow">→</span><span data-zh="原创是释放">ORIGINAL</span></div>
        </div>
      </div>
    </div>
  </section>
  <section class="section soft"><div class="container"><div class="section-heading"><div class="eyebrow" data-zh="更好的对话">Better conversations</div><h2 data-zh="让回复有你的声音。">Your voice, three ways.</h2><p data-zh="同一个帖子给出三种不同角度。切换已有候选不消耗额外次数。">One post, three useful angles. Switching between suggestions does not use another generation.</p></div><div class="grid-3"><div class="feature-card"><span class="feature-icon">✦</span><h3 data-site-text="feature1Title" data-zh="自然">Natural</h3><p data-site-text="feature1Body" data-zh="像朋友一样真诚接话，贴合原帖，不刻意推销。">A genuine response that follows the original post without sounding promotional.</p></div><div class="feature-card"><span class="feature-icon">◌</span><h3 data-site-text="feature2Title" data-zh="幽默">Playful</h3><p data-site-text="feature2Body" data-zh="轻松一点，留住有趣的瞬间，而不是硬造笑点。">A lighter tone that notices the funny part without forcing a joke.</p></div><div class="feature-card"><span class="feature-icon">↗</span><h3 data-site-text="feature3Title" data-zh="观点">Thoughtful</h3><p data-site-text="feature3Body" data-zh="补充真实看法，让讨论往前走一步。">Add a point of view that moves the conversation forward.</p></div></div></div></section>
  <section class="section"><div class="container grid-3"><div class="grid-span-2"><div class="eyebrow" data-zh="你的表达方式">Voice Profile</div><h2 data-zh="写作样本让建议更贴近你。">Give it examples. Keep your voice.</h2><p class="lead" data-zh="设置语气、兴趣与写作样本。x-Reply-Helper 生成草稿时会参考这些内容，你随时可以修改个人风格。">Set your tone, interests, and writing samples. x-Reply-Helper uses them when drafting, and you can change them anytime.</p></div><div class="content-card"><h3 data-zh="你始终掌控发送">You stay in control</h3><p data-zh="建议可以填入 X 回复框，供你检查和编辑。插件不会自动点击发送。">Suggestions can enter X's reply box for your review. The extension never presses Send for you.</p></div></div></section>
  <section class="section"><div class="container"><div class="section-heading"><div class="eyebrow" data-zh="简单开始">A simple start</div><h2 data-zh="从注册到第一条回复，只需三步。">Your first reply in three steps.</h2></div><div class="grid-3"><div class="feature-card"><span class="step-number">01</span><h3 data-zh="验证邮箱">Verify your email</h3><p data-zh="创建账户并验证邮箱，然后在插件中连接账户以领取新人免费额度。">Create an account, verify your email, then connect your account in the extension to receive welcome credits.</p></div><div class="feature-card"><span class="step-number">02</span><h3 data-zh="连接插件">Connect the extension</h3><p data-zh="在插件设置中心绑定同一账户。你的余额会同步显示。">Connect the same account in the extension to see your balance.</p></div><div class="feature-card"><span class="step-number">03</span><h3 data-zh="挑选并编辑">Choose and edit</h3><p data-zh="查看三种建议，挑选适合的一条。发送之前始终由你确认。">Pick from three suggestions, edit your choice and confirm before sending.</p></div></div></div></section>
  <section id="home-subscriptions" class="section soft" hidden aria-labelledby="home-subscription-title">
    <div class="container"><div class="section-heading"><div class="eyebrow" id="home-subscription-eyebrow"></div>
      <h2 id="home-subscription-title"></h2><p id="home-subscription-description" class="lead"></p>
    </div><div id="home-subscription-cards" class="home-subscription-grid"></div>
    <p id="home-subscription-disclosure" class="fineprint" style="margin-top:18px"></p>
    <a class="button secondary" href="/pricing" id="home-subscription-link"></a></div>
  </section>
  <section id="home-legacy-pricing" class="section soft"><div class="container"><div class="section-heading"><div class="eyebrow" data-zh="简单透明的额度">Simple credit pricing</div><h2 data-site-text="packageTitle" data-zh="先用 200 次，再按需充值。">Start with 200, top up when needed.</h2></div><div class="grid-3"><div class="pricing-card featured"><h3 data-zh="免费赠送">Free grant</h3><div class="price">$0</div><p data-account-status>正在确认账户状态…</p><a class="button" data-account-cta href="/login?mode=register" hidden><span>免费注册领取</span></a></div><div class="pricing-card grid-span-2"><h3 data-zh="按需充值">Credit packs</h3><p data-site-text="packageBody" data-zh="按需选择适合你的生成额度，官网人民币标价就是实际付款价格，支付手续费由商家承担。">Choose the credits you need. CNY prices shown on our website are the final payment amounts; processing fees are paid by the merchant.</p><p class="notice" data-zh="可按需购买永久额度包，也可以选择 30 天订阅；无需自行配置 API Key。">Choose permanent credit packs or a 30-day subscription; no personal API key required.</p><a class="button secondary" href="/pricing" data-zh="查看套餐">View packages</a></div></div></div></section>
  <section id="home-credit-packages" class="section" hidden aria-labelledby="home-credit-title">
    <div class="container">
      <div class="section-heading">
        <div class="eyebrow" data-zh="永久额度包">Permanent credit packs</div>
        <h2 id="home-credit-title" data-zh="按需购买，官网标价即实付。">Buy as needed. The displayed CNY price is the final amount.</h2>
        <p data-zh="按后台最新人民币价格展示，支付通道手续费由商家承担，不再向用户额外加收。">Live CNY prices from our pricing settings. Payment processing fees are covered by the merchant.</p>
      </div>
      <div id="featured-packages" class="grid-3"></div>
      <a class="button secondary" href="/pricing#packages" style="margin-top:22px" data-zh="查看所有永久额度包">See all permanent credit packs</a>
    </div>
  </section>
  <section class="section"><div class="container"><div class="section-heading"><h2 data-zh="常见问题">Questions, answered.</h2></div><p class="lead" data-site-text="faq" hidden></p><div class="faq-item" data-site-faq-default><h3 data-zh="它会自动发送评论吗？">Will it post for me?</h3><p data-zh="不会。你可以编辑草稿，并且必须自己确认发送。">No. You review and edit the draft, then decide whether to send it.</p></div><div class="faq-item" data-site-faq-default><h3 data-zh="需要自己的 API Key 吗？">Do I need my own API key?</h3><p data-zh="不需要。验证邮箱后，请在插件中连接账户以领取新人免费额度。">No. Hosted AI is included; verify your email and connect your account in the extension to receive welcome credits.</p></div><div class="faq-item" data-site-faq-default><h3 data-zh="如何查看充值套餐？">Where can I find credit packs?</h3><p data-zh="在价格页查看当前套餐和可用的支付方式。">Visit pricing for current packages and available payment methods.</p></div><div style="margin-top:28px"><a class="button secondary" href="/faq" data-zh="查看更多问题">More answers</a></div></div></section>
  <script>
    import {api} from "../lib/api";
    import {renderFeaturedPackages} from "../lib/package-summary.mjs";
    type HomeSubscriptionPlan={plan_code:string;price_fen:number;daily_limit:number;duration_days:number;name_zh:string;name_en:string};
    let subscriptionCheckout=false;
    let homeSubscriptions:HomeSubscriptionPlan[]|null=null;
    function renderHomeSubscriptions(){
      if(!homeSubscriptions)return;
      const en=document.documentElement.lang==='en';
      const t=(zh:string,english:string)=>en?english:zh;
      const set=(id:string,value:string)=>{const el=document.getElementById(id);if(el)el.textContent=value;};
      set('home-subscription-eyebrow',t('订阅主推','Subscriptions first'));
      set('home-subscription-title',t('每天高频回复？30 天订阅更适合你。','Reply often? A 30-day subscription fits.'));
      set('home-subscription-description',t('订阅每天 500 至 2,000 次、每 24 小时重置。订阅当天用完后先扣免费额度，再扣不主动过期的永久额度包；也可以按剩余时间补差价升级订阅。','Subscriptions offer 500–2,000 daily generations and reset every 24h. When the daily allowance runs out, free credits are used before permanent paid credits; eligible users can also upgrade at a prorated price.'));
      set('home-subscription-disclosure',t('订阅不自动续费 · 未使用日额度不累计 · 永久额度包不主动过期 · 互动势能临界值对所有付费用户开放。','Subscriptions do not auto-renew · Unused daily allowance does not roll over · Permanent credits do not expire automatically · Creator Momentum is available to paid users.'));
      if(!subscriptionCheckout)set('home-subscription-disclosure',t('订阅结账尚未开放 · 永久额度包可独立购买，不主动过期。','Subscription checkout is not yet available · Permanent credit packs are separate purchases and do not expire automatically.'));
      set('home-subscription-link',t('了解订阅与永久额度包的区别','Compare subscriptions and permanent credits'));
      const container=document.getElementById('home-subscription-cards')!;
      container.replaceChildren();
      for(const p of homeSubscriptions){
        const card=document.createElement('div');card.className='pricing-card'+(p.plan_code==='pro'?' featured home-subscription-featured':'');
        const name=document.createElement('h3');name.textContent=en?p.name_en:p.name_zh;
        const price=document.createElement('div');price.className='price';price.textContent='¥'+(p.price_fen/100).toFixed(2);
        const detail=document.createElement('p');detail.textContent=p.daily_limit.toLocaleString()+t(' 次/天 · 30 天',' daily · 30 days');
        const badge=document.createElement('p');badge.className='eyebrow';badge.textContent=p.plan_code==='pro'?t('推荐档','Recommended'):p.plan_code.toUpperCase();
        card.append(badge,name,price,detail);container.append(card);
      }
    }
    async function loadHomeSubscriptions(){
      try{
        const data=await api<{plans:HomeSubscriptionPlan[];autoRenew:boolean;checkoutAvailable:boolean}>('/v1/subscriptions/plans');
        if(data.autoRenew!==false||!data.plans.length||data.plans.length>4||data.plans.some(p=>!['basic','pro','max','ultra'].includes(p.plan_code)||!Number.isSafeInteger(p.price_fen)||p.price_fen<=0||!Number.isSafeInteger(p.daily_limit)||p.duration_days!==30))return;
        subscriptionCheckout=data.checkoutAvailable===true;
        homeSubscriptions=data.plans;
        document.getElementById('home-subscriptions')!.hidden=false;
        document.getElementById('home-legacy-pricing')!.hidden=true;
        renderHomeSubscriptions();renderFeatured();
      }catch{/* If subscription rollout is disabled, retain old credit-first site. */}
    }
    void loadHomeSubscriptions();
    window.addEventListener('reply-copilot-language',renderHomeSubscriptions);
    let featuredSource:unknown[]=[];
    function renderFeatured(){
       const container=document.getElementById("featured-packages"),section=document.getElementById("home-credit-packages");
       if(!container||!section)return;
       renderFeaturedPackages(document,container,featuredSource,document.documentElement.lang==="en"?"en":"zh");
       section.hidden=container.hidden;
     }
    void api<{packages:unknown[]}>("/v1/packages").then(data=>{featuredSource=data.packages;renderFeatured();}).catch(()=>{featuredSource=[];renderFeatured();});
    window.addEventListener("reply-copilot-language",renderFeatured);
  </script>
  <style>:global(.package-highlight){border:1px solid #94b8e7;background:#f8fbff}:global(.package-badge){font-size:12px;font-weight:600;color:#2361a8}.home-subscription-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:16px}.home-subscription-featured{border:2px solid #2663ac}</style>
</Base>
