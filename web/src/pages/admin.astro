---
import Base from "../layouts/Base.astro";
import AdminDashboard from "../components/admin/AdminDashboard";
---
<Base title="管理后台" titleEn="Admin dashboard">
  <header class="container admin-page-heading" aria-label="Admin console heading">
    <div class="admin-page-heading-kicker">
      <span class="admin-page-heading-dot" aria-hidden="true"></span>
      <span>REPLY HELPER / CONSOLE</span>
    </div>
    <h1 data-zh="管理后台">Admin dashboard</h1>
    <p data-zh="在一个工作区管理收入、订单、订阅、用户与 AI 使用情况。">Manage revenue, orders, subscriptions, users and AI usage in one workspace.</p>
  </header>
  <section class="container admin-app-shell app-shell" aria-label="Admin operations">
    <AdminDashboard client:load />
  </section>
</Base>
