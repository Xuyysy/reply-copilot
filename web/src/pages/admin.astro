---
import Base from "../layouts/Base.astro";
---
<Base title="管理后台">
  <div class="container page-hero"><div class="eyebrow">Reply Copilot</div><h1>管理后台</h1><p class="lead">管理员需要登录、输入安全口令并完成动态验证码验证。</p></div>
  <section class="container" style="padding-bottom:100px"><div class="form-card" style="margin:0;max-width:100%"><label class="field">管理员安全口令<input id="admin-secret" type="password" autocomplete="off" placeholder="仅在本次页面使用，不保存在浏览器" /></label><label class="field">验证器动态验证码<input id="admin-code" inputmode="numeric" maxlength="6" autocomplete="one-time-code" placeholder="6 位数字" /></label><div class="button-row"><button id="admin-load" class="button">验证并加载后台</button><button id="admin-enroll" class="button secondary" type="button">首次设置二次验证</button><button id="admin-confirm" class="button secondary" type="button">确认绑定验证器</button></div><p id="admin-enrollment" class="status" role="status"></p><p id="admin-message" class="status" role="status"></p></div><div id="dashboard" hidden>
    <h2>概览</h2><div id="metrics" class="stat-grid"></div>
    <div class="content-card" style="margin-top:24px"><h2>用户管理</h2><label class="field">搜索用户名或邮箱<input id="user-search" /></label><button id="search-users" class="button secondary">搜索</button><div id="users"></div></div>
    <div class="content-card" style="margin-top:24px"><h2>额度管理</h2><p>先在用户列表复制用户 ID，再填写调整原因。扣除额度时填写负数。</p><form id="adjust-form"><label class="field">用户 ID<input name="userId" required /></label><label class="field">额度类型<select name="kind"><option value="free">免费</option><option value="paid">付费</option></select></label><label class="field">调整次数<input name="delta" type="number" min="-10000" max="10000" required /></label><label class="field">原因，至少 8 字<input name="reason" minlength="8" maxlength="500" required /></label><button class="button" type="submit">预览并确认调整</button></form><div id="ledger"></div></div>
    <div class="content-card" style="margin-top:24px"><h2>套餐管理</h2><div id="packages"></div></div>
    <div class="content-card" style="margin-top:24px"><h2>订单</h2><div id="orders"></div></div>
    <div class="content-card" style="margin-top:24px"><h2>系统设置</h2><div id="settings"></div></div>
  </div></section>
  <script>
    import {api,ApiError} from "../lib/api";
    const $=(id:string)=>document.getElementById(id)!;
    const msg=(text:string)=>{$("admin-message").textContent=text;};
    const secret=()=>($('admin-secret') as HTMLInputElement).value;
    const code=()=>($('admin-code') as HTMLInputElement).value.trim();
    let adminToken="",tokenExpiresAt=0;
    const headers=()=>({"X-Admin-Access":secret(),"X-Admin-Session":adminToken});
    const read=<T,>(path:string)=>api<T>(path,{headers:headers()});
    const write=<T,>(path:string,body:object)=>api<T>(path,{method:"POST",headers:headers(),body:JSON.stringify(body)});
    const challenge=<T,>(path:string,body:object)=>api<T>(path,{method:"POST",headers:{"X-Admin-Access":secret()},body:JSON.stringify(body)});
    const div=(text:string)=>{const element=document.createElement("div");element.textContent=text;return element;};
    const button=(text:string,click:()=>void)=>{const element=document.createElement("button");element.className="button secondary";element.textContent=text;element.type="button";element.addEventListener("click",click);return element;};
    async function load(){try{
      if(!adminToken||Date.now()>=tokenExpiresAt){const elevated=await challenge<{accessToken:string;expiresAt:number}>("/v1/admin/mfa/elevate",{code:code()});adminToken=elevated.accessToken;tokenExpiresAt=elevated.expiresAt;($('admin-code') as HTMLInputElement).value="";}
      const [metrics,users,packages,orders,settings,ledger]=await Promise.all([
        read<Record<string,unknown>>("/v1/admin/dashboard"),read<{users:any[]}>("/v1/admin/users"),read<{packages:any[]}>("/v1/admin/packages"),read<{orders:any[]}>("/v1/admin/orders"),read<{settings:any[]}>("/v1/admin/settings"),read<{ledger:any[]}>("/v1/admin/ledger")]);
      $("dashboard").hidden=false;msg("数据已更新。");const metricBox=$("metrics");metricBox.replaceChildren();const labels:Record<string,string>={users:"用户总数",verifiedUsers:"已验证用户",todayUsers:"今日新用户",todayGenerations:"今日生成",monthGenerations:"本月生成",totalFreeGranted:"免费额度总发放",paidCreditsSpent:"付费额度已消费",monthRevenueCents:"本月收入（美分）",abnormalRequests:"异常请求"};for(const [key,label] of Object.entries(labels)){const card=document.createElement("div");card.className="stat";card.append(div(label),div(String(metrics[key]??0)));metricBox.append(card);}const cost=metrics.cost as any;metricBox.append(div(`本月输入 Token ${cost?.inputTokens??0} · 输出 Token ${cost?.outputTokens??0} · 估算成本 $${((cost?.costMicroUsd??0)/1_000_000).toFixed(4)}`));metricBox.append(div(`今日估算成本 $${((Number(metrics.dailyCostMicroUsd)||0)/1_000_000).toFixed(4)} / 预算 $${((Number(metrics.budgetLimitMicroUsd)||0)/1_000_000).toFixed(4)} · ${metrics.circuitOpen?"熔断已触发":metrics.costWarning?"接近预算上限":"预算正常"}`));
      metricBox.append(div(`生成中预留 $${((Number(metrics.reservedCostMicroUsd)||0)/1_000_000).toFixed(4)}`));renderUsers(users.users);renderPackages(packages.packages);
      const orderBox=$("orders");orderBox.replaceChildren();for(const order of orders.orders)orderBox.append(div(`${order.id} · ${order.email} · ${order.package_name} · 套餐 $${(order.amount_cents/100).toFixed(2)} · 手续费 ${order.fee_cents===null?"待报价":`$${(order.fee_cents/100).toFixed(2)}`} · 渠道 ${order.payment_method||"未选择"} · ${order.status} · ${order.credited_at?"已发放":"未发放"}`));if(!orders.orders.length)orderBox.textContent="暂无订单。";
      const ledgerBox=$("ledger");ledgerBox.replaceChildren();for(const item of ledger.ledger)ledgerBox.append(div(`${new Date(item.created_at).toLocaleString("zh-CN")} · ${item.email} · ${item.kind} · 免费 ${item.free_delta} · 付费 ${item.paid_delta} · ${item.reason||""}`));if(!ledger.ledger.length)ledgerBox.textContent="暂无流水。";
      const settingBox=$("settings");settingBox.replaceChildren();for(const item of settings.settings){const row=document.createElement("div");row.className="button-row";const input=document.createElement("input");input.value=item.value;input.setAttribute("aria-label",item.key);row.append(div(item.key),input,button("保存",async()=>{if(!confirm(`确定修改 ${item.key}？`))return;try{await write(`/v1/admin/settings/${item.key}`,{value:input.value});msg("设置已保存。");}catch(error){msg(error instanceof Error?error.message:"保存失败。");}}));settingBox.append(row);}
    }catch(error){msg(error instanceof ApiError?error.message:"后台加载失败。");}}
    function renderUsers(users:any[]){const box=$("users");box.replaceChildren();for(const user of users){const row=document.createElement("div");row.className="button-row";row.append(div(`${user.username||"旧用户"} · ${user.email} · 免费 ${user.free_balance} / 付费 ${user.paid_balance} · 已生成 ${user.generations} · ${user.status} · ID ${user.id}`),button(user.status==="frozen"?"解冻":"冻结",async()=>{const status=user.status==="frozen"?"active":"frozen";if(!confirm(`确定${status==="frozen"?"冻结":"解冻"} ${user.email}？`))return;try{await write(`/v1/admin/users/${user.id}/status`,{status});await load();}catch(error){msg(error instanceof Error?error.message:"操作失败。");}}));box.append(row);}if(!users.length)box.textContent="没有匹配账户。";}
    function renderPackages(packages:any[]){const box=$("packages");box.replaceChildren();for(const pkg of packages){const form=document.createElement("form");form.className="button-row";form.innerHTML=`<strong></strong><label>中文名<input name="nameZh"></label><label>英文名<input name="nameEn"></label><label>次数<input name="credits" type="number"></label><label>美分<input name="priceCents" type="number"></label><label>促销美分<input name="promoPriceCents" type="number"></label><label>排序<input name="sortOrder" type="number"></label><label>上架<input name="active" type="checkbox"></label><button class="button secondary">保存</button>`;form.querySelector("strong")!.textContent=pkg.id;for(const key of ["nameZh","nameEn","credits","priceCents","sortOrder"]){const field=form.elements.namedItem(key) as HTMLInputElement;field.value=String(({nameZh:pkg.name_zh,nameEn:pkg.name_en,credits:pkg.credits,priceCents:pkg.price_cents,sortOrder:pkg.sort_order} as any)[key]);}(form.elements.namedItem("promoPriceCents") as HTMLInputElement).value=pkg.promo_price_cents??"";(form.elements.namedItem("active") as HTMLInputElement).checked=pkg.active===1;form.addEventListener("submit",async event=>{event.preventDefault();if(!confirm(`确定修改 ${pkg.id}？既有订单价格不会变化。`))return;const values=Object.fromEntries(new FormData(form));try{await write(`/v1/admin/packages/${pkg.id}`,{nameZh:values.nameZh,nameEn:values.nameEn,credits:Number(values.credits),priceCents:Number(values.priceCents),promoPriceCents:values.promoPriceCents===""?null:Number(values.promoPriceCents),sortOrder:Number(values.sortOrder),active:Boolean(values.active)});msg("套餐已更新。");}catch(error){msg(error instanceof Error?error.message:"保存失败。");}});box.append(form);}}
    $("admin-load").addEventListener("click",()=>void load());$("search-users").addEventListener("click",async()=>{try{renderUsers((await read<{users:any[]}>(`/v1/admin/users?q=${encodeURIComponent(($('user-search') as HTMLInputElement).value)}`)).users);}catch(error){msg(error instanceof Error?error.message:"搜索失败。");}});
    $("admin-enroll").addEventListener("click",async()=>{try{const result=await challenge<{secret:string;otpauth:string}>("/v1/admin/mfa/start",{});$("admin-enrollment").textContent=`请在验证器中手动添加密钥：${result.secret}。添加后输入动态验证码并点击“确认绑定验证器”。请勿截图或分享密钥。`;msg("设置将在 10 分钟后过期。");}catch(error){msg(error instanceof Error?error.message:"无法开始设置。");}});
    $("admin-confirm").addEventListener("click",async()=>{try{await challenge("/v1/admin/mfa/confirm",{code:code()});$("admin-enrollment").textContent="";msg("二次验证已启用。请等待下一组验证码后加载后台。");($('admin-code') as HTMLInputElement).value="";}catch(error){msg(error instanceof Error?error.message:"绑定失败。");}});
    $("adjust-form").addEventListener("submit",async event=>{event.preventDefault();const values=Object.fromEntries(new FormData(event.currentTarget as HTMLFormElement));const delta=Number(values.delta);if(!confirm(`确定为用户 ${values.userId} ${delta>0?"增加":"扣除"} ${Math.abs(delta)} 次${values.kind==="free"?"免费":"付费"}额度？原因：${values.reason}`))return;try{await write(`/v1/admin/users/${values.userId}/credits`,{kind:values.kind,delta,reason:values.reason,confirm:true});await load();}catch(error){msg(error instanceof Error?error.message:"调整失败。");}});
  </script>
</Base>
