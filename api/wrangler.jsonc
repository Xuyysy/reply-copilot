{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reply-copilot-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-14",
  "workers_dev": false,
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  },
  "vars": {
    "ENVIRONMENT": "development",
    "WEB_ORIGIN": "http://127.0.0.1:4321",
    "API_ORIGIN": "http://127.0.0.1:8787",
    "EXTENSION_ORIGIN": "",
    "SITE_DAILY_CAP": "300",
    "PAYMENTS_ENABLED": "0",
    "XIAODOU_WEBHOOKS_ENABLED": "0",
    "PAYMENT_PROVIDER": "mock",
    "DISPOSABLE_EMAIL_DOMAINS": "mailinator.com,guerrillamail.com,tempmail.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reply-copilot-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "staging": {
      "name": "reply-copilot-api-staging",
      "workers_dev": false,
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "redact_query_string": true,
        "logs": {
          "invocation_logs": false
        }
      },
      "vars": {
        "ENVIRONMENT": "staging",
        "AI_MODE": "production",
        "AI_PROMPT_V3_EXPERIMENT": "1",
        "ADMIN_PORTAL_ENABLED": "1",
        "XIAODOU_NETWORK_DIAGNOSTIC_ENABLED": "0",
        "DEEPSEEK_INPUT_USD_PER_MILLION": "0.30",
        "DEEPSEEK_OUTPUT_USD_PER_MILLION": "1.32",
        "WEB_ORIGIN": "https://staging.x-reply-helper.top",
        "API_ORIGIN": "https://api-staging.x-reply-helper.top",
        "EXTENSION_ORIGIN": "chrome-extension://kaaehkpihjenlhjjfjcopkjhegmfmchk",
        "PAYMENTS_ENABLED": "1",
        "XIAODOU_WEBHOOKS_ENABLED": "1",
        "MK99_NOTIFY_DIAGNOSTICS_ENABLED": "0",
        "PAYMENT_PROVIDER": "xiaodou_epay",
        "XIAODOU_RETURN_URL": "https://staging.x-reply-helper.top/account/",
        "DISPOSABLE_EMAIL_DOMAINS": "mailinator.com,guerrillamail.com,tempmail.com"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "reply-copilot-staging",
          "database_id": "cd44bb44-b525-42c4-b286-2cc84dae7fdb",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "name": "reply-copilot-api-production",
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "production",
        "AI_MODE": "production",
        "ADMIN_PORTAL_ENABLED": "0",
        "WEB_ORIGIN": "https://app.x-reply-helper.top",
        "API_ORIGIN": "https://api.x-reply-helper.top",
        "EXTENSION_ORIGIN": "chrome-extension://fgfjajofkapebgphfidblngcjomkbdaj",
        "SITE_DAILY_CAP": "300",
        "PAYMENTS_ENABLED": "0",
        "XIAODOU_WEBHOOKS_ENABLED": "1",
        "PAYMENT_PROVIDER": "xiaodou",
        "DISPOSABLE_EMAIL_DOMAINS": "mailinator.com,guerrillamail.com,tempmail.com",
        "SUBSCRIPTIONS_ENABLED": "0",
        "SUBSCRIPTION_PURCHASES_ENABLED": "0",
        "SUBSCRIPTION_CHECKOUT_ENABLED": "0"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "reply-copilot-production",
          "database_id": "d9df7d23-9b9c-44ac-a33a-c24474c15691",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
