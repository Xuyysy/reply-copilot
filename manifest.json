{
  "manifest_version": 3,
  "name": "x-Reply-Helper",
  "short_name": "x-Reply-Helper",
  "version": "0.3.12",
  "version_name": "0.3.12",
  "description": "x-Reply-Helper：用你的语气生成可编辑的 X 回复草稿。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "116",
  "permissions": [
    "contextMenus",
    "storage",
    "sidePanel",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_page": "options/options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "content/inline-assistant.css",
        "content/momentum.css"
      ],
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "x-Reply-Helper",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "utils/generation-performance.js",
        "content/post-extractor.js",
        "content/reply-detector.js",
        "content/composer-adapter.js",
        "content/composer-association.js",
        "content/momentum-presenter.js",
        "content/inline-assistant.js",
        "content/content-script.js",
        "content/coldstart-prewarm.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
